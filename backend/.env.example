# إعدادات البيئة - انسخ الملف إلى .env وعدّل القيم عند الحاجة
PORT=4000

DB_USER=root
# كلمة مرور قاعدة البيانات - نفس قيمة DB_PASSWORD في ملف .env بجذر المشروع (مطلوبة، بلا افتراضي)
DB_PASSWORD=

# العقدة A - قاعدة بيانات فرع الخرطوم
DB_HOST_A=localhost
DB_PORT_A=3307
DB_NAME_A=nahda_khartoum

# العقدة B - قاعدة بيانات فرع عطبرة
DB_HOST_B=localhost
DB_PORT_B=3308
DB_NAME_B=nahda_atbara

# فعّلها true فقط عند الاتصال بقواعد سحابية تشترط TLS (مثل TiDB Cloud)
DB_SSL=false

# مفتاح توقيع رموز الدخول JWT - مطلوب: نص عشوائي طويل من عندك، ولن يعمل الخادم بدونه أو بقيمة جاهزة
JWT_SECRET=

# مفتاح تشفير الحقول الحساسة - ولّده بـ: npm run setup:key
DATA_ENCRYPTION_KEY=

# ==== اختياري: بيانات مختلفة لكل عقدة (مثلاً قاعدتان سحابيتان منفصلتان) ====
# إن تُركت فارغة تُستخدم DB_USER/DB_PASSWORD المشتركة أعلاه
DB_USER_A=
DB_PASSWORD_A=
DB_USER_B=
DB_PASSWORD_B=
# حد الاتصالات المتزامنة لكل قاعدة (خطط مجانية مثل Clever Cloud DEV = 5 كحد أقصى)
DB_POOL_LIMIT=2
