# ============================================================
# إعداد جاهز لقاعدتي Clever Cloud (نهضة) - انسخه إلى backend/.env
# وأكمل الفراغات الأربعة المعلّمة فقط
# ============================================================
PORT=4000

# نص عشوائي طويل من عندك (مثال: حروف وأرقام 40+ خانة)
JWT_SECRET=

# مفتاح التشفير: نفّذ  npm run setup:key  والصق السطر الناتج هنا
DATA_ENCRYPTION_KEY=

# ==== العقدة A - فرع الخرطوم (Clever Cloud) ====
DB_HOST_A=bv9jtp0plbijfhyb5njg-mysql.services.clever-cloud.com
DB_PORT_A=3306
DB_NAME_A=bv9jtp0plbijfhyb5njg
DB_USER_A=u5z7k4g51rsrdl7p
# ← كلمة مرور قاعدة الخرطوم: من رابط الخزنة (Khartoum DB)
DB_PASSWORD_A=

# ==== العقدة B - فرع عطبرة (Clever Cloud) ====
DB_HOST_B=bowqbkhv6e0w9en8hhd2-mysql.services.clever-cloud.com
DB_PORT_B=3306
DB_NAME_B=bowqbkhv6e0w9en8hhd2
DB_USER_B=ur7zrylmcklvwtr1
# ← كلمة مرور قاعدة عطبرة: من رابط الخزنة (Atbara DB)
DB_PASSWORD_B=

# حد الاتصالات المتزامنة لكل قاعدة (خطة DEV المجانية = 5 كحد أقصى)
DB_POOL_LIMIT=2

# تشفير الاتصال (TLS) مع تحقق من شهادة الخادم المثبتة في backend/certs - اتركه true
DB_SSL=true
